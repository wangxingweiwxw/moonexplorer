{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moonexplorer",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/zhihu-callback"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://moon.chipai.cc",
    "ZHIHU_APP_ID": "849",
    "ZHIHU_REDIRECT_URI": "https://moon.chipai.cc/zhihu-callback"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "moonexplorer-saves",
    "database_id": "59612008-51c8-4e5b-94e0-b3ace2bd36b5"
  }]
}
